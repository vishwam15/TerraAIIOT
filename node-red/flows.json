  {
    "id": "validate_moisture",
    "type": "function",
    "z": "tab_terrawave_iot",
    "name": "Validate & Structure Moisture",
    "func": "var data = msg.payload;\nif (typeof data === 'string') {\n    try { data = JSON.parse(data); } catch(e) {}\n}\nvar moisture = typeof data.soilMoisture !== 'undefined' ? Number(data.soilMoisture) : null;\nif (moisture === null || isNaN(moisture) || moisture < 0 || moisture > 100) {\n    node.warn('Invalid moisture reading rejected: ' + JSON.stringify(data));\n    return null;\n}\nmsg.payload = {\n    sensorId: data.sensorId || 'ESP32-S3-001',\n    soilMoisture: moisture,\n    rawADC: data.rawADC || null,\n    source: data.source || 'esp32',\n    timestamp: new Date().toISOString()\n};\nmsg.headers = { 'Content-Type': 'application/json' };\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 620,
    "y": 120,
    "wires": [["http_post_telemetry"]]
  },
  {
    "id": "validate_tank",
    "type": "function",
    "z": "tab_terrawave_iot",
    "name": "Validate & Handle NO ECHO",
    "func": "var data = msg.payload;\nif (typeof data === 'string') {\n    try { data = JSON.parse(data); } catch(e) {}\n}\nvar tankLevel = typeof data.tankLevel !== 'undefined' ? Number(data.tankLevel) : -1;\nmsg.payload = {\n    sensorId: data.sensorId || 'ESP32-S3-001',\n    tankLevel: tankLevel,\n    status: (tankLevel === -1 || data.status === 'NO ECHO') ? 'NO ECHO' : 'OK',\n    source: data.source || 'esp32',\n    timestamp: new Date().toISOString()\n};\nmsg.headers = { 'Content-Type': 'application/json' };\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 630,
    "y": 200,
    "wires": [["http_post_telemetry"]]
  },
  {
    "id": "function_format_pump_status",
    "type": "function",
    "z": "tab_terrawave_iot",
    "name": "Format Pump Status Event",
    "func": "var topic = msg.topic;\nvar pumpId = topic.indexOf('pump1') !== -1 ? 'PUMP_1' : 'PUMP_2';\nvar state = msg.payload.toString().trim().toUpperCase();\nvar isOn = state === 'FILL_ON' || state === 'PUMP_ON' || state === 'ON';\nmsg.payload = {\n    pumpId: pumpId,\n    action: isOn ? 'ON' : 'OFF',\n    source: 'esp32_mqtt',\n    timestamp: new Date().toISOString()\n};\nmsg.headers = { 'Content-Type': 'application/json' };\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 610,
    "y": 320,
    "wires": [["http_post_pump_event"]]
  },
